# Copy this file to `.env.local` (or set these in Vercel) and fill in your own values.
# NEVER commit the real file — .gitignore already excludes it.

# ── NEAR Intents 1Click ──────────────────────────────────────────────────────
# Defaults are fine for mainnet. A JWT is optional; with one, 1Click waives its 0.2% fee.
ONECLICK_BASE_URL=https://1click.chaindefuser.com
# Partner key from https://partners.near-intents.org (removes the 0.2% unauthenticated fee).
# Use ONECLICK_API_KEY (recommended, sent as X-API-Key). ONECLICK_JWT is the legacy option.
ONECLICK_API_KEY=
ONECLICK_JWT=
# EXACT_INPUT (default): user sends a fixed NEAR amount, which fills far more reliably.
# EXACT_OUTPUT: we name the exact stablecoin to deliver; refunded for small amounts in testing.
ONECLICK_SWAP_TYPE=EXACT_INPUT
# Max slippage the user's side may carry, in basis points (100 = 1%).
ONECLICK_SLIPPAGE_BPS=100

# What the user pays with. wNEAR — the app wraps the user's NEAR in the same transaction.
ORIGIN_ASSET=nep141:wrap.near

# What lands in OUR account. Use the exact assetId from https://1click.chaindefuser.com/v0/tokens
# Working route (2026-11-12): native USDC on Avalanche. Recipient = a 0x… wallet SliqPay holds the keys to.
SETTLEMENT_ASSET=nep141:avax-0xb97ef9ef8734c71904d8002f8b6bc66dd9c48a6e.omdep.near
# Alternative, settle on NEAR (did not fill for small amounts in testing):
#   SETTLEMENT_ASSET=nep141:17208628f84f5d6ad33f0da3bbbeb27ffcb398eac501a31bd6ad2011e36133a1   (USDC)
#   SETTLEMENT_ASSET=nep141:usdt.tether-token.near                                          (USDT)
#   and SETTLEMENT_RECIPIENT=<NEAR account already registered for that token, e.g. sliqpay.near>
SETTLEMENT_DECIMALS=6
# REQUIRED. Must match the chain above; the server refuses to start otherwise.
SETTLEMENT_RECIPIENT=

# ── VTPass (airtime delivery) ────────────────────────────────────────────────
# LIVE: https://vtpass.com/api      SANDBOX: https://sandbox.vtpass.com/api
VTPASS_BASE_URL=https://vtpass.com/api
# REQUIRED. From your VTPass dashboard → API keys.
VTPASS_API_KEY=
VTPASS_SECRET_KEY=

# ── Pricing ──────────────────────────────────────────────────────────────────
# Leave empty to use CoinGecko's live USDC→NGN price, or set a fixed rate for a demo.
NGN_PER_USDC=
# Extra on top of the bill to cover the rate moving (100 = 1%). Kept by SliqPay if unused.
PRICE_BUFFER_BPS=100
# Demo limits in naira.
MIN_AMOUNT_NGN=100
# Smallest order in USD. Market makers ignore swaps under ~$1–2; the naira floor follows the live rate.
MIN_ORDER_USD=2
MAX_AMOUNT_NGN=5000

# ── Order store ──────────────────────────────────────────────────────────────
# Optional for `npm run dev` (orders are kept in memory).
# REQUIRED when deployed (Vercel): a free Upstash Redis database → REST URL + token.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
